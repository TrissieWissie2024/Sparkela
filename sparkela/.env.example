# Sparkela environment variables (docs/PLAN.md §3.9). Names only: put real values in .env.local (ignored by git)
# or in the Vercel project settings. Never commit a value.
#
# Without any keys the site runs completely with COMMERCE_PROVIDER=local, and the forms show hallo@sparkela.nl
# as a fallback. Production on Vercel (VERCEL_ENV=production, set by Vercel) always needs COMMERCE_PROVIDER=shopify;
# the build fails otherwise.
#
# Secrets marked [secret, >= 32 chars] must be at least 32 characters, created with: openssl rand -base64 32
# A shorter value counts as missing and the feature stays off (fail closed).

# --- Commerce --------------------------------------------------------------------------------------------------

# "local" (default: test products from content/products.ts, cart in the browser) or "shopify". Server and build.
COMMERCE_PROVIDER=

# Public base URL for metadataBase, sitemap and JSON-LD. Default: https://sparkela.nl. Inlined at build time.
NEXT_PUBLIC_SITE_URL=

# --- Shopify Storefront API (catalog and cart; required with COMMERCE_PROVIDER=shopify) --------------------------

# Store domain without https://, for example sparkela.myshopify.com.
SHOPIFY_STORE_DOMAIN=
# Private token of the Headless sales channel. Server only.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# "private" (default) or "public": decides which Storefront header carries the token.
SHOPIFY_STOREFRONT_TOKEN_TYPE=

# --- Shopify Admin API (only /api/subscribe and /api/subscribe/confirm) -------------------------------------------

# Client id and secret of the app in the Dev Dashboard (scopes read_customers, write_customers). The site exchanges
# them for a token of about 24 hours (client credentials grant).
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Optional override: a fixed shpat_ token of an older custom app. Wins over the client credentials when set.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Shopify webhooks and accounts --------------------------------------------------------------------------------

# Key Shopify signs webhooks with (Settings > Notifications > Webhooks). Required for /api/revalidate webhooks.
SHOPIFY_WEBHOOK_SECRET=
# Optional target of /account, for example https://account.sparkela.nl. Read by proxy.ts.
SHOPIFY_CUSTOMER_ACCOUNT_URL=

# --- Revalidation ---------------------------------------------------------------------------------------------------

# [secret, >= 32 chars] Optional bearer token for manual revalidation: POST /api/revalidate with
# Authorization: Bearer <token> and body {"tags":["klok"]}.
REVALIDATE_SECRET=

# --- Mail (Resend; needed for withdrawal, contact and the double opt-in confirmation mail) -----------------------

MAIL_API_KEY=
# Verified sender, for example: Sparkela <hallo@sparkela.nl>
MAIL_FROM=
# Sparkela inbox that receives the copies.
MAIL_TO=

# --- Prelaunch, preview and early access (read by proxy.ts) --------------------------------------------------------

# [secret, >= 32 chars] Preview link before the launch: https://sparkela.nl/?preview=<token>. Without it: no preview.
PRELAUNCH_BYPASS_TOKEN=
# [secret, >= 32 chars] Signs the early-access links per drop (npm run early-access-link -- <slug>).
# Without it early access does not work (fail closed). Also read by the server.
EARLY_ACCESS_SECRET=

# --- Newsletter (double opt-in) ------------------------------------------------------------------------------------

# [secret, >= 32 chars] Signs the confirmation link. Without it /api/subscribe answers "not-configured"
# (never a silent single opt-in).
NEWSLETTER_CONFIRM_SECRET=

# --- Analytics (inlined at build time) -----------------------------------------------------------------------------

# "true" turns on the consent banner and, after consent, Google Tag Manager. Default: off.
NEXT_PUBLIC_ANALYTICS_ENABLED=
# Container id, for example GTM-XXXXXXX.
NEXT_PUBLIC_GTM_ID=

# --- Test clock (never active when VERCEL_ENV=production) ---------------------------------------------------------

# "1" turns on the test clock; it only works together with SPARKELA_TEST_NOW. npm run build:test and
# npm run start:test set both (tests/test-env.mjs).
SPARKELA_TEST_CLOCK=
# ISO time with offset for the test clock, for example 2026-11-27T12:00:00+01:00.
SPARKELA_TEST_NOW=

# --- Tests and tooling (optional, local only) ----------------------------------------------------------------------

# "1" turns on npm run test:shopify (read-only test against the real store; logs the query cost).
SHOPIFY_LIVE_TEST=
# "1" also runs the Admin test of plan §11.9 step 3 (creates a test customer).
SHOPIFY_LIVE_ADMIN=
# Run Playwright against a server that already runs via npm run start:test, for example http://localhost:3200.
PLAYWRIGHT_BASE_URL=
# Path to a Chromium binary for Playwright (the cloud container provides one).
PW_CHROMIUM_PATH=
# CORVANE content folder for the overlap check in content/content-guard.test.ts (optional).
CORVANE_CONTENT_DIR=
