{
  "name": "sparkela",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-images.mjs",
    "build": "next build",
    "start": "next start",
    "build:test": "node scripts/build-images.mjs && node scripts/with-test-env.mjs next build",
    "start:test": "node scripts/with-test-env.mjs next start -p 3200",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shopify": "SHOPIFY_LIVE_TEST=1 vitest run tests/unit/shopify-live.test.ts",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts --project=mobile --project=desktop",
    "logo": "node scripts/build-logo.mjs",
    "images": "node scripts/build-images.mjs",
    "early-access-link": "node scripts/early-access-link.mjs",
    "capture:reference": "node scripts/capture-reference.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
